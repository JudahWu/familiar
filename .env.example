# Familiar 环境变量样例。
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交。

# ---- 模型与代码托管 ----
# 所有 *_API_KEY / *_SECRET_KEY / *_TOKEN 都是占位符，填你自己的真实值。
# 真值只放在本地 .env（已被 .gitignore 忽略），绝不提交进仓库。
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL="https://api.deepseek.com"
MAIN_MODEL=deepseek-v4-pro

# 三家代码托管平台的令牌，只填你要用的那家即可（可同时填）。
# 平台按用户输入的仓库地址域名自动判断：gitee.com / github.com / gitlab.com。
# 令牌只通过 GIT_ASKPASS 注入到 git 子进程，不会出现在命令行或日志里。
GITEE_TOKEN=""
GITEE_API_BASE_URL="https://gitee.com/api/v5"

# GitHub：个人访问令牌（fine-grained 或 classic 都行，需要 repo 权限）
GITHUB_TOKEN=""
GITHUB_API_BASE_URL="https://api.github.com"

# GitLab：PAT（需要 api 权限）；自建实例把 GITLAB_BASE_URL 换成自己的地址，
# 之后 https://git.example.com/group/repo 这类地址就会被认成 GitLab。
GITLAB_TOKEN=""
GITLAB_BASE_URL="https://gitlab.com"

# ---- 工作区与数据目录 ----
# Agent 只允许操作这个工作区下的仓库文件。
# 默认 ~/ai_workspace（跨平台）；Windows 想保留旧路径就显式指定 E:\ai_workspace。
AI_WORKSPACE_ROOT=

# SQLite 数据目录默认落在项目内 data/，日志落在项目内 logs/，
# 一般不需要配置；需要自定义时再取消注释。
# FAMILIAR_DATA_DIR=/absolute/path/to/data
# FAMILIAR_LOG_DIR=/absolute/path/to/logs

# ---- 外部服务（PostgreSQL / Redis / OpenSandbox）----
# 三者由 deploy/docker-compose.yml 统管，本地默认值如下，通常无需修改。
# 持久化后端：sqlite（默认，零依赖）或 postgres（接 deploy/docker-compose 的 PG）。
# 设为 postgres 后，会话历史/记忆/业务数据落到 PostgreSQL，重启服务不丢。
PERSISTENCE_TYPE=sqlite
# PERSISTENCE_TYPE=postgres
DATABASE_URL=postgresql://root:root@localhost:5432/familiar
# Redis 实时事件总线（pub/sub，类似消息队列），密码 root。
REDIS_URL=redis://:root@localhost:6379
# OpenSandbox agent 沙箱服务地址（SANDBOX_TYPE=opensandbox 时启用）。
OPENSANDBOX_URL=http://localhost:8080
# 知识库向量库（deploy/docker-compose 里的 milvus 服务，Attu 管理界面在 http://localhost:8000）
MILVUS_URI=http://localhost:19530

# 知识库原始文件存储（deploy/docker-compose 的 minio 服务，S3 兼容）。
# 控制台在 http://localhost:9003，账号密码就是下面这两项。
# 注意变量名不叫 MINIO_ROOT_*：那两个已经被 Langfuse 的 lf-minio 占用了，
# 在这里赋值会顺手改掉 Langfuse 的账号。
S3_ENDPOINT=http://127.0.0.1:9002
S3_ACCESS_KEY=familiar
S3_SECRET_KEY=YOUR_MINIO_SECRET_KEY
S3_BUCKET=familiar-knowledge

# ---- 向量与多模态 ----
# 文本与图片必须用同一个向量模型（它们落在同一个 dense 字段里，不同模型的向量
# 之间距离没有意义，图文互搜会出乱子）。
# provider=dashscope 走 DashScope 原生接口——多模态 embedding 在 OpenAI 兼容模式下
# 不可用（实测 /embeddings 返回 404）。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=multimodal-embedding-v1
EMBEDDING_DIM=1024

# 插图描述模型，走 OpenAI 兼容端点
ALIBABA_API_KEY=YOUR_ALIBABA_API_KEY
ALIBABA_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus

# 版面识别服务（可选）。OpenAI 兼容端点，模型名默认 dots_ocr。
# 留空就降级：只抽 PDF 内嵌的位图，操作截图类插图仍然拿得到，
# 但矢量流程图拿不到，无文字层的扫描页也不会被识别。
OCR_BASE_URL=
OCR_MODEL=dots_ocr

# ---- 知识库问答 ----
# 生成答案用哪个模型。留空就跟随 MAIN_MODEL——不填等于"跟着主模型走"。
# 单独设置的价值：知识库可以换成更便宜的，或换成能看图的 qwen3-vl-plus，
# 而不影响编码 Agent 的选择。
# 注意：qwen* 会走 ALIBABA_API_KEY / ALIBABA_BASE_URL，其余走 DEEPSEEK_*。
KNOWLEDGE_MODEL=

# 自评（给答案打分）用哪个模型。留空也跟随 MAIN_MODEL。
# 刻意留独立配置：评委和被评的是同一个模型容易自说自话，想换就换这里。
KNOWLEDGE_JUDGE_MODEL=

# 低于这个分数就把答案标成"待确认"，前端让用户选采信还是换联网重答。
KNOWLEDGE_SCORE_THRESHOLD=0.7

# 送进上下文的段落数。多了会把提示词撑长，检索的边际收益下降很快。
KNOWLEDGE_TOP_K=5

# 导入时是否做语义分段（把相邻句子/段落按语义相似度合并成更大的块）。
# 关掉能明显缩短大书的导入时间——代价是切分边界退化成纯字数切割。
KNOWLEDGE_SEMANTIC_CHUNK=true

# dots_ocr 版面解析服务（vLLM 起的 OpenAI 兼容端点，模型根目录 DotsOCR）。
# 留空则退回 PyMuPDF 抽文字层——那条路对扫描版 PDF 等于没有正文。
# 服务端启动参考：vllm serve /data/dots_deploy/DotsOCR --port 18000
DOTS_OCR_BASE_URL=
DOTS_OCR_MODEL=model
# 渲染分辨率。200 是原项目的默认值；降下来会丢小字，升上去单页耗时会涨。
DOTS_OCR_DPI=200
# 同时解析几页。按显卡显存调，6 是单卡比较稳的值。
DOTS_OCR_CONCURRENCY=6
DOTS_OCR_TIMEOUT=300
DOTS_OCR_MAX_TOKENS=8192
# 运行沙箱 backend 开关：local_shell（默认，本机 subprocess 跑命令）
# 或 opensandbox（隔离容器，工作区子目录以 host 卷挂载进容器）。
SANDBOX_TYPE=local_shell
# SANDBOX_TYPE=opensandbox
# OpenSandbox 容器镜像。
# 官方 python:*{-slim} 镜像里**没有 git**（也没有 curl/node），coding 任务会在
# clone/commit/push 时失败。请用 deploy/sandbox/Dockerfile 构建带 git 的镜像：
#     scripts/build_sandbox_image.sh
# 然后指到同一个 tag。换镜像时务必保留 python3（BaseSandbox 的 ls/read/edit/
# grep/glob 默认实现都靠容器内 python3 跑脚本）。
OPENSANDBOX_IMAGE=familiar/sandbox:latest
# ---- Langfuse LLM 观测 ----
# 自托管实例由 deploy/docker-compose.yml 统管，UI/API 在 http://localhost:3001。
# key 在 Langfuse 项目 Settings → API Keys 里创建；缺任一 key 时观测整体关闭，
# 不影响 agent 运行（一次 agent 运行 = 一条 trace）。
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
LANGFUSE_BASE_URL="http://localhost:3001"
# 基础设施密钥（deploy/docker-compose.yml 的 Langfuse/ClickHouse/MinIO 读取）。
# 这些会加密 Langfuse 数据、作为 ClickHouse/MinIO 密码，务必改成随机值再首次启动；
# 一旦启动后就别改，否则已有 trace 与数据会解不开。
LF_SALT=YOUR_LANGFUSE_SALT
LF_ENCRYPTION_KEY=YOUR_LANGFUSE_ENCRYPTION_KEY
LF_NEXTAUTH_SECRET=YOUR_LANGFUSE_NEXTAUTH_SECRET
LF_CH_PWD=YOUR_CLICKHOUSE_PASSWORD
LF_MINIO_PWD=YOUR_MINIO_ROOT_PASSWORD
# 环境标签，用来把本地调试和线上流量的 trace 分开筛。
LANGFUSE_ENVIRONMENT=local
# 采样率：本地 1.0 全采，线上量大可降到 0.1。
LANGFUSE_SAMPLE_RATE=1.0
# 沙箱空闲多少秒后回收（每次 execute/upload/download 会重置计时）。
# 默认 1800s = 30 分钟，对齐 GitHub Codespaces 默认值。
OPENSANDBOX_IDLE_TIMEOUT=1800
# 沙箱硬生命周期（秒），只当兜底；空闲回收才是主机制。默认 43200s = 12 小时。
# 注意 OpenSandbox server 强制下限 60 秒，低于此值创建直接 422。
OPENSANDBOX_MAX_LIFETIME=43200

# 联网搜索已改用 DeepSeek 的 /v1/tools/search，复用 DEEPSEEK_API_KEY；
# 这一项不再被读取，留在这里只是提醒你以前配过。
# ZHIPU_API_KEY=""
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"

DEFAULT_REPO_PROVIDER="gitee"
# 创建会话时未显式传 repo 参数时使用的默认仓库。留空则默认不绑定仓库。
DEFAULT_REPO_URL=
LANGCHAIN_TRACING_V2=
LANGSMITH_TRACING=false
DASHBOARD_BASE_URL=http://127.0.0.1:3000
DASHBOARD_API_BASE_URL=http://127.0.0.1:2024
# CORS 允许的前端来源，逗号分隔；生产环境改成实际前端域名。
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---- 登录鉴权 ----
# 是否强制登录。默认 true；本地开发可临时设 false 跳过登录（不推荐）。
AUTH_ENABLED=true
# 会话 JWT 签名密钥。必须配置为足够长的随机串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 未配置时服务每次启动会生成随机密钥，重启后所有会话失效。
DASHBOARD_JWT_SECRET=
# 用户列表，格式：邮箱:密码哈希,邮箱:密码哈希
# 密码哈希用 scripts/create_admin.py 生成，例如：
#   python scripts/create_admin.py admin@example.com
DASHBOARD_USERS=
# 管理员邮箱，逗号分隔。未配置时所有已登录用户都视为管理员（单用户默认）。
DASHBOARD_ADMINS=
# 兼容旧配置名：DASHBOARD_ADMINS 未设置时读取 CONFIGURED_ADMINS。
CONFIGURED_ADMINS=
# 本地开发一键登录（GET /dashboard/api/auth/dev-login）。
# 生产环境必须设为 false，并清空 DASHBOARD_DEV_PASSWORD。
DASHBOARD_DEV_LOGIN=false
DASHBOARD_DEV_EMAIL=
DASHBOARD_DEV_PASSWORD=
# HTTPS 部署时设为 true，会话 Cookie 才带 Secure 标记。
SESSION_COOKIE_SECURE=false

SANDBOX_TYPE=local_shell
LOCAL_SHELL_WORKSPACE=
LOCAL_SHELL_PROJECTS_DIR=projects
LOCAL_SHELL_SHARED_PYTHON_VENV=runtimes/python/default/.venv
LOCAL_SHELL_ENABLE_COMMAND_GUARD=true
LOCAL_SHELL_ALLOW_NETWORK=true
# Logging rotation. Current logs are backend.log / agent-runs.log; rotated logs use .YYYY-MM-DD suffix.
FAMILIAR_LOG_LEVEL=INFO
FAMILIAR_LOG_RETENTION_DAYS=14
FAMILIAR_LOG_WHEN=midnight
FAMILIAR_LOG_INTERVAL=1

# ---- 日志落盘（默认关闭）----
# 默认只打 stdout + 发 OTel（进 ClickHouse，Grafana 查）。设 true 才落本地文件，
# 且按大小轮转（不是按天），单文件到 LOG_FILE_MAX_MB 就换下一个。
LOG_FILE_ENABLED=false
LOG_FILE_MAX_MB=50
LOG_FILE_BACKUP_COUNT=5

# ---- OpenTelemetry（logs / metrics 出口）----
# 应用只发 OTLP 到本地 otel-collector(4318)，由它分流到 ClickHouse 与 Prometheus。
# collector 没起来时会安静退化成只打 stdout，不影响业务。
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=familiar
OTEL_ENVIRONMENT=local

# ---- Grafana（账号密码，端口 3002）----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_PASSWORD

# Agent 运行保护阈值。复杂 coding 任务需要给代码修改、测试和 Git/PR 收尾预留足够工具调用额度。
AGENT_MAX_TOOL_CALLS=240
AGENT_MAX_SECONDS=1800
AGENT_CODING_MAX_TOOL_CALLS=300
AGENT_CODING_MAX_SECONDS=1800
